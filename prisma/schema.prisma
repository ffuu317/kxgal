generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../backend/data/dev.db"
}

model User {
  id               String               @id
  phone            String               @unique
  passwordHash     String
  nickname         String
  avatarUrl        String
  bio              String               @default("")
  status           String               @default("active")
  level            String               @default("L0")
  creditCoin       Int                  @default(0)
  warningCount     Int                  @default(0)
  isMerchant       Boolean              @default(false)
  merchantStatus   String               @default("pending")
  idCardVerified   Boolean              @default(false)
  fingerprintHash  String?
  lastLoginAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  posts            Post[]
  comments         Comment[]
  likes            PostLike[]
  files            File[]
  sessions         Session[]
  transactions     CreditTransaction[]
  bountyPosts      Bounty[]             @relation("BountyPublisher")
  bountyAccepts    Bounty[]             @relation("BountyAcceptor")
  merchant         Merchant?
  weeklyRankings   WeeklyRanking[]

  @@map("users")
}

model Post {
  id            String     @id
  authorId      String
  title         String
  content       String
  coverImageUrl String
  imageUrlsJson String     @default("[]")
  merchantName  String     @default("")
  tagsJson      String     @default("[]")
  likeCount     Int        @default(0)
  commentCount  Int        @default(0)
  status        String     @default("published")
  aiVerified    String     @default("pending")
  postType      String     @default("recommend") // recommend | avoid
  isBountyRecord Boolean    @default(false)
  merchantId    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  author        User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  likes         PostLike[]
  merchant      Merchant?  @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([postType])
  @@map("posts")
}

model Comment {
  id             String   @id
  postId         String
  authorId       String
  content        String
  status         String   @default("published")
  aiVerified     String   @default("pending")
  consumedCoins  Int      @default(0)
  receiptImageUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model PostLike {
  id        String   @id
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model File {
  id        String   @id
  ownerId   String
  url       String
  mimeType  String
  size      Int
  purpose   String
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("files")
}

model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model CreditTransaction {
  id              String   @id
  userId          String
  type            String
  amount          Int
  reason          String
  relatedId       String?
  balanceBefore   Int
  balanceAfter    Int
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_transactions")
}

model Merchant {
  id              String              @id
  userId          String              @unique
  businessName    String
  businessAddress String
  businessLicense String?
  licenseImageUrl String?
  status          String              @default("pending")
  latitude        Float?
  longitude       Float?
  mapIcon         String              @default("🏠")
  lastKitchenUpload DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bounties        Bounty[]
  posts           Post[]
  merchantPhotos  MerchantPhoto[]
  weeklyRankings  WeeklyRanking[]

  @@map("merchants")
}

model MerchantPhoto {
  id          String   @id
  merchantId  String
  photoType   String   // kitchen | dish | environment | activity
  url         String
  aiVerified  String   @default("pending")
  uploadedAt  DateTime @default(now())
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("merchant_photos")
}

model Bounty {
  id              String   @id
  publisherId     String
  acceptorId      String?
  merchantId      String?
  merchantName    String
  merchantAddress String
  description     String
  imageUrlsJson   String   @default("[]")
  rewardCoins     Int      @default(50)
  status          String   @default("active")
  aiVerified      String   @default("pending")
  deadline        DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publisher       User     @relation("BountyPublisher", fields: [publisherId], references: [id], onDelete: Cascade)
  acceptor        User?    @relation("BountyAcceptor", fields: [acceptorId], references: [id], onDelete: SetNull)
  merchant        Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([publisherId])
  @@index([acceptorId])
  @@index([merchantId])
  @@map("bounties")
}

model WeeklyRanking {
  id         String   @id
  weekNumber Int
  year       Int
  rankType   String   // popularity | credit | active
  userId     String?
  merchantId String?
  rank       Int
  score      Int
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant?  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([weekNumber, year, rankType, userId])
  @@unique([weekNumber, year, rankType, merchantId])
  @@index([weekNumber, year, rankType])
  @@map("weekly_rankings")
}
